{
  "num_interferers": 1,
  "use_pim": false,
  
  "core_simulation_parameters": {
    "modulation_type": "GMSK",
    "channel_model": "TU50",
    "channel_memory": 6,
    "target_ratio_range_db": {
      "start": -5,
      "stop": 25,
      "step": 1.0
    },
    "traceback_depth": 5
  },
  
  "mode_selection": {
    "calculation_mode": "SINR",
    "channel_estimation_method": "lmmse",
    "combining_mode": "IRC",
    "irc_regularization": 0.1
  },
  
  "physical_layer_parameters": {
    "bs_nf_db": 0,
    "fs_hz": 200e6,
    "temp_k": 290
  },
  
  "burst_structure_parameters": {
    "burst_symbol_rate": "normal",
    "num_bursts": 300
  },
  
  "file_paths": {
    "channel_mat_file": "./channel/quadriga.mat"
  },
  
  "results_output": {
    "save_results": true,
    "save_mse_debug": false,
    "output_directory": "./results"
  },
  
  "saic": {
    "apply_saic_preprocessing": false,
    "method": "basic",
    "regularization": 1e-6,
    "thermal_noise_variance": 1e-6
  },
  
  "temporal_whitening": {
    "apply_temporal_whitening": false,
    "method": "bias_removal",
    "regularization": 1e-6,
    "thermal_noise_variance": null,
    "full_burst": true
  },
  
  "channel_sweep": {
    "enabled": false,
    "models": ["AWGN", "TU50", "EQ50", "HT100", "RA130"]
  },
  
  "power_parameters": {
    "bs_tx_power_dbm": 43.0,
    "bs_antenna_gain_dbi": 18.0,
    "ms_antenna_gain_dbi": 2.0,
    "path_loss_db": 120.0,
    "channel_bandwidth_hz": 200000.0
  }
}
